{
  "name": "Melf's Minute Meteors",
  "type": "spell",
  "img": "icons/magic/fire/projectile-meteor-salvo-heavy-red.webp",
  "system": {
    "description": {
      "value": "<p><strong>Operational summary:</strong> cast it to create six meteors (+2 for each slot level above 3rd), shown in the effect name. Right after casting, <em>Hurl Meteor</em> throws one or two of them at no extra cost; from the end of that turn it is replaced by <em>Hurl Meteor (Bonus Action)</em>, one or two meteors with your bonus action on each later turn. Each meteor: a 5-foot-radius sphere within 120 feet, Dexterity save against your spell save DC, 2d6 fire damage (half on a success). In combat the module blocks a third meteor in the same turn; the spell ends when the last meteor is hurled or concentration is lost.</p>",
      "chat": ""
    },
